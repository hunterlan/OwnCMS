@using OwnCMS.Application.Features.Articles.DTOs
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=8">
    <meta name="author" content="Kostiantyn Sharykin">
    <title>@ViewBag.Title OldSoftware</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OwnCMS.Presentation.styles.css" asp-append-version="true"/>
</head>
<body>
<div class="xp-container">
    <div class="xp-sidebar">
        <div class="sidebar-text">
            <p>Welcome to the blog installation wizard</p>
        </div>
        
        @{
            var uncategorizedArticles = ViewBag.UncategorizedArticles as List<ArticleLinkDto>;
            var categorizedArticles = ViewBag.CategorizedArticles as List<CategoryArticlesDto>;
            
            if ((uncategorizedArticles != null && uncategorizedArticles.Any()) || (categorizedArticles != null && categorizedArticles.Any()))
            {
                <div class="sidebar-categories">
                    @if (uncategorizedArticles != null && uncategorizedArticles.Any())
                    {
                        <ul class="article-list article-list-root">
                            @foreach (var article in uncategorizedArticles)
                            {
                                <li><a href="/article/@article.Slug">@article.Title</a></li>
                            }
                        </ul>
                    }
                    
                    @if (categorizedArticles != null && categorizedArticles.Any())
                    {
                        @foreach (var category in categorizedArticles)
                        {
                            <div class="xp-install-step">
                                <div class="xp-step-header">@category.CategoryName</div>
                                <div class="xp-step-content">
                                    <ul class="article-list">
                                        @foreach (var article in category.Articles)
                                        {
                                            <li><a href="/article/@article.Slug">@article.Title</a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
        
    <div class="xp-content">
        @RenderBody()
    </div>
</div>

<div class="footer">
    <div class="footer-buttons">
        <button class="xp-button">&lt; Back</button>
        <button class="xp-button xp-button-primary">Next &gt;</button>
    </div>

    <div class="estimated-time">
        <p>Estimated time remaining: </p>
        <p><strong>Forever enjoying this retro design</strong></p>
    </div>
</div>
</body>
</html>