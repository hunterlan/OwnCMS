@using OwnCMS.Application.Features.Articles.DTOs
@model IEnumerable<ShortArticleDto>
@{
    ViewBag.Title = "";
    Layout = "_Layout";
}

<div class="blog-posts">
    @if (!Model.Any())
    {
        <div class="xp-window">
            <div class="xp-title-bar">
                <div class="xp-title-text">Information</div>
                <div class="xp-title-controls">
                    <button class="xp-close-button">X</button>
                </div>
            </div>
            <div class="xp-window-content">
                <div class="xp-message">
                    <p>There are currently no articles to display.</p>
                    <p>Please check back later or start by creating your first post!</p>
                </div>
            </div>
            <div class="xp-window-buttons">
                <button class="xp-button">OK</button>
            </div>
        </div>
    }
    else
    {
        foreach (var post in Model)
        {
            <div class="blog-post">
                <h3>@post.Title</h3>
                <p class="post-date">Posted on: @post.CreatedAt</p>
                <p class="post-excerpt">@post.ShortContent</p>
                <a href="/article/@post.Slug" class="read-more">Read more &raquo;</a>
            </div>
        }
    }
</div>
